@LIT_SITE_CFG_IN_HEADER@

config.llvm_tools_dir = lit_config.substitute(r"@LLVM_TOOLS_DIR@")
config.spruce_tools_dir = lit_config.substitute(r"@CURRENT_TOOLS_DIR@")
config.spruce_test_exec_root = r"@CMAKE_CURRENT_BINARY_DIR@"

import lit.llvm

lit.llvm.initialize(lit_config, config)
lit_config.load_config(config, r"@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py")
